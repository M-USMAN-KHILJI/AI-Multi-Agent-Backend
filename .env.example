# Example Environment Configuration
PROJECT_NAME="OmniAgent AI Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modeldb
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/modeldb

# LLM Provider: Groq Cloud (Ultra-Fast LLaMA 3.3 70B Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile  

# NVIDIA FLUX API Key (for image generation)
FLUX_API_KEY=your_nvidia_flux_api_key_here

# Generated assets directory
GENERATED_DIR=generated

# Server Host & Port
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
