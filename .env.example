# Project Environment Configuration
PROJECT_NAME="OmniAgent AI Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modeldb
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/modeldb

# LLM Provider: Groq Cloud (Text AI Agent)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# NVIDIA Vision API: Google PaliGemma (Visual Understanding & VQA)
NVIDIA_VISION_API_KEY=your_nvidia_vision_api_key_here
NVIDIA_VISION_MODEL=google/paligemma
NVIDIA_VISION_URL=https://ai.api.nvidia.com/v1/vlm/google/paligemma

# NVIDIA GenAI API Configuration (FLUX 3 Image Klein - Photorealistic Diffusion)
NVIDIA_API_KEY=your_nvidia_flux_api_key_here
NVIDIA_FLUX_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux-3-image-klein

# Hugging Face Video Generation (Video AI Agent - Lightricks LTX-Video)
HUGGINGFACE_API_KEY=your_huggingface_token_here
HF_VIDEO_MODEL=Lightricks/ltx-video-distilled

# NVIDIA Resemble.AI Chatterbox Multilingual TTS
NVIDIA_TTS_API_KEY=your_nvidia_tts_api_key_here
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
NVIDIA_TTS_VOICE=Chatterbox-Multilingual.en-US.Male

# Server Host & Port
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
