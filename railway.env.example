# Railway Production Environment Variables Guide
# Set these in your Railway Project Settings -> Variables

# Server Environment
ENVIRONMENT=production
DEBUG=False
PORT=8000
CORS_ORIGINS=*

# Database (Railway Postgres Plugin sets DATABASE_URL automatically)
# If using Railway Postgres, reference it using: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/dbname

# AI Agent API Credentials
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VISION_API_KEY=your_nvidia_vision_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

